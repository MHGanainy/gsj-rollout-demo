# gsj-rollout-demo — the stranger's config. Copy to config.yaml and fill in.
#
# Three values are genuinely yours: where your corpus is, where your
# inference endpoint is, and what the served model is called. Everything
# else about the estate (URLs, networks, secrets, ports, pins) is stood up
# by ./bootstrap.py and therefore derived by it.

# Your corpus, in the contract's shape
# (https://github.com/MHGanainy/gsj-harness-rollout-server/blob/main/docs/corpus-contract.md).
# For the worked example: ./synthetic/make_corpus.py writes this tree.
corpus: ./corpus-synthetic

inference:
  # Your endpoint's ROOT — no /v1 suffix (Polar appends /v1/chat/completions
  # itself). A host-local endpoint (127.0.0.1:...) is fine: the bootstrap
  # rewrites it so containers reach your host, and says so — BUT the
  # endpoint must then be listening beyond loopback (0.0.0.0, or at least
  # the docker bridge), because the estate's gateway calls it from a
  # container. A server bound to 127.0.0.1 only is unreachable from there;
  # the bootstrap's engine check will tell you.
  #
  # What the endpoint must satisfy:
  #   - a tool-call parser (tools arrive as OpenAI tool definitions)
  #   - a context window >= harness context_window (default 32768)
  #   - pinned sampling defaults — pi sends NO sampling parameters, so your
  #     server's generation defaults ARE the sampling policy
  base_url: http://127.0.0.1:8000
  # Byte-for-byte the name your server serves (it must appear in
  # GET <base_url>/v1/models).
  model: Qwen/Qwen3-0.6B

# ---- optional, defaulted — uncomment only if your endpoint differs ---------
# The window the harness plans against; must not exceed your endpoint's.
#context_window: 32768
# Per-turn generation budget.
#max_tokens: 8192
# The served tokenizer's end-of-turn token id. The default (151645,
# <|im_end|>) is Qwen3's. For any other inference.model the bootstrap
# DERIVES this from your endpoint's own template render at `up` (needs
# vLLM's /tokenize + /detokenize; on an engine without them the default
# silently stands and THIS key is the cure — docs/MODEL-SURFACE.md has
# the from-snapshot recipe). Set it explicitly only to override, and know
# the explicit value wins (./preflight.py's end-of-turn row checks
# whichever is in effect).
#end_of_turn_token_id: 151645
# The glue stitch, for a chat template that rewrites history by a CONSTANT
# span (./preflight.py's template row measures this and prints the exact
# list when it applies — do not guess it). Reconstruction re-inserts these
# ids at each turn opening. Leave unset on the reference stack: the
# symmetric template needs no stitch (what changes with the model:
# docs/MODEL-SURFACE.md).
#generation_prompt_glue_ids: [151667, 271, 151668, 271]
# Thinking mode. Off by default. `medium` is the conventional ON (every
# non-off pi level is wire-equivalent under qwen-chat-template); a bare
# `on` is a YAML boolean and is rejected by name. Switching modes is a
# config edit + `./bootstrap.py up` — pins re-derive for the mode and the
# Polar services restart so the receiver's archive stamp follows.
#thinking: medium
